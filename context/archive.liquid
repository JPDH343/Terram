    image-rendering: pixelated;
    cursor: pointer;
    display: block;
  }

  .game-canvas:focus {
    outline: 3px solid #8FFF00;
    outline-offset: 3px;
  }

  .game-info {
    color: #8FFF00;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    text-align: center;
  }

  /* Game Block Styles */
  .block-game-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem;
    background: #000;
    border-radius: 4px;
  }

  .game-header {
    color: #8FFF00;
    font-family: 'Courier New', monospace;
    font-size: 1.2rem;
    font-weight: bold;
    text-transform: uppercase;
  }

  .game-canvas {
    border: 2px solid #8FFF00;
    background: #000;
    image-rendering: pixelated;
    cursor: pointer;
  }

  .game-canvas:focus {
    outline: 2px solid #8FFF00;
    outline-offset: 2px;
  }

  .game-controls {
    color: #8FFF00;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    text-align: center;
  }
  
  /* Show/hide controls based on device */
  .game-controls-mobile,
  .game-info.game-controls-mobile {
    display: none;
  }
  
  @media (max-width: 768px) {
    .game-controls-desktop,
    .game-info.game-controls-desktop {
      display: none;
    }
    .game-controls-mobile,
    .game-info.game-controls-mobile {
      display: block;
    }
  }

  /* Doom-specific canvas styling */
  .doom-canvas {
    /* High-res 1600x1000 canvas scaled down to 600x375 for crisp display */
    width: 600px !important;
    height: 375px !important;
    max-width: 600px !important;
    max-height: 375px !important;
    aspect-ratio: 16 / 10 !important;
    object-fit: contain !important;
    display: block;
  }
  
  /* Hide Doom debug elements */
  #fps,
  #hE,
  #hQ,
  #qQ {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
  
  /* Hide Doom map editor panel - try multiple selectors */
  body > div[style*="position: absolute"][style*="left: 850px"],
  div[style*="position: absolute"][style*="left: 850px"],
  canvas#hQ,
  canvas#qQ {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
  }

  .file-window__empty {
    padding: 2rem;
    text-align: center;
    color: #666;
    font-style: italic;
  }
{% endstylesheet %}

