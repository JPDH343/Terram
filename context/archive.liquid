    <!-- Hidden file content data -->
    <div id="file-data-storage" style="display: none;">
      {% for file in shop.metaobjects.archive_file.values %}
        {% assign content_blocks = file.content_blocks.value %}
        <div class="file-data" 
             data-file-id="{{ file.file_name | handleize }}"
             data-file-name="{{ file.file_name }}"
             data-folder="{{ file.folder }}"
             data-timestamp="{{ file.timestamp }}">
          {% for content_block in content_blocks %}
            <!-- DEBUG: Block type = {{ content_block.system.type }} -->
            {% if content_block.system.type == 'archive_text_block' %}
              <!-- DEBUG: Text block found -->
              <div class="content-block" data-block-type="text" data-font-family="{{ content_block.font_family }}" data-font-size="{{ content_block.font_size }}">
                <div class="block-text-content">{{ content_block.text_content }}</div>
              </div>
            {% elsif content_block.system.type == 'archive_image_block' %}
              <!-- DEBUG: Image block found, image = {{ content_block.image }}, scale = {{ content_block.scale }} -->
              <div class="content-block" data-block-type="image" data-scale="{{ content_block.scale | default: 100 }}">
                <div class="block-image-content">{{ content_block.image | image_url: width: 1200 | image_tag }}</div>
              </div>
            {% elsif content_block.system.type == 'archive_video_block' %}
              <div class="content-block" data-block-type="video" data-scale="{{ content_block.scale | default: 100 }}">
                <div class="block-video-content">
                  {% if content_block.video_url != blank %}
                    <video controls>
                      <source src="{{ content_block.video_url }}" type="video/mp4">
                    </video>
                  {% else %}
                    <p style="color: #888;">Add video URL from Content > Files in the "Video URL" field.</p>
                  {% endif %}
                </div>
              </div>
            {% elsif content_block.system.type == 'archive_game_block' %}
              <div class="content-block" data-block-type="game" data-game-type="{{ content_block.game }}" data-scale="{{ content_block.scale | default: 100 }}">
                <div class="block-game-content">
                  <div class="game-header">{{ content_block.display_name | default: content_block.game }}</div>
                  {% if content_block.game == 'doomclone' %}
                    <canvas class="game-canvas doom-canvas" width="600" height="375"></canvas>
                    <div class="game-controls">Click to start. Move: WASD | Aim/Shoot: Mouse/Click | Press Ctrl+Shift+R to hard refresh if black screen</div>
                  {% elsif content_block.game == 'brickbreaker' %}
                    <canvas class="game-canvas" width="400" height="400"></canvas>
                    <div class="game-controls game-controls-desktop">Use arrow keys to play</div>
                    <div class="game-controls game-controls-mobile">Touch and drag to play</div>
                  {% elsif content_block.game == 'snake' %}
                    <canvas class="game-canvas" width="400" height="400"></canvas>
                    <div class="game-controls game-controls-desktop">Use arrow keys to play</div>
                    <div class="game-controls game-controls-mobile">Swipe to move</div>
                  {% else %}
                    <canvas class="game-canvas" width="400" height="400"></canvas>
                    <div class="game-controls">Use arrow keys to play. Press SPACE or ENTER to start.</div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
